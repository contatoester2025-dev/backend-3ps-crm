# Segurança do endpoint de envio (o CRM manda esse token no header x-token)
BACKEND_TOKEN=invente_uma_senha_forte

# Se "true", responde automaticamente "Recebi: ..." pra testar o ciclo completo
AGENTE_ECO=true

# Agente de IA (fase 2)
ANTHROPIC_API_KEY=sk-ant-...
# opcionais (valores padrão entre parênteses)
# AGENTE_INTERVALO_MIN=30            (a cada 30 min)
# AGENTE_HORA_INICIO=8               (só envia a partir das 8h)
# AGENTE_HORA_FIM=20                 (até as 20h)
# AGENTE_MAX_POR_CORRETOR_DIA=5      (limite de lembretes por corretor por dia)
# AGENTE_REPETICAO_HORAS=48          (não cobra o mesmo lead de novo antes de 48h)
